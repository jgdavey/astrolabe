{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}

  ;; astrolabe, from this repo
  com.joshuadavey/astrolabe {:local/root "../.."}

  ;; the SDK adapter for our server, plus the optional brotli module
  dev.data-star.clojure/http-kit {:mvn/version "1.0.0-RC11"}
  dev.data-star.clojure/brotli   {:mvn/version "1.0.0-RC11"}

  ;; brotli4j is a native library: one classifier per platform you run on. Add
  ;; com.aayushatharva.brotli4j/native-linux-aarch64 for ARM Linux.
  com.aayushatharva.brotli4j/native-linux-x86_64 {:mvn/version "1.22.0"}
  com.aayushatharva.brotli4j/native-osx-aarch64  {:mvn/version "1.22.0"}
  com.aayushatharva.brotli4j/native-osx-x86_64   {:mvn/version "1.22.0"}

  http-kit/http-kit         {:mvn/version "2.8.1"}
  metosin/reitit-ring       {:mvn/version "0.10.1"}
  metosin/jsonista          {:mvn/version "0.3.13"}
  ;; chassis rather than hiccup: this example re-renders the whole board five
  ;; times a second, so rendering is squarely on the hot path.
  dev.onionpancakes/chassis {:mvn/version "1.0.365"}}

 :aliases
 {:run {:main-opts ["-m" "game-of-life.main"]
        ;; brotli4j loads a native library; without this the JVM warns about it
        :jvm-opts  ["--enable-native-access=ALL-UNNAMED"]}}}
